        <mxCell id="g15H5Ib15jul5QJKnl-Z-34" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;Ключи шифрования&lt;br&gt;Данные интеграции с госорганами&lt;br&gt;Финансовые данные&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
